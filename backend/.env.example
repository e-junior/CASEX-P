# Copy values into the server process environment. Do not commit real credentials.
HOST=127.0.0.1
PORT=8000
PUBLIC_BASE_URL=https://api.example.com
DATABASE_PATH=backend/data/vaipropolo.sqlite3
PRIVATE_UPLOAD_DIR=backend/private_uploads
CORS_ORIGIN=https://app.example.com

# IDs de contas autorizadas ao endpoint administrativo; informe UUIDs separados por vírgula.
ADMIN_ACCOUNT_IDS=

# Generate a unique value with secrets.token_urlsafe(48); keep it in a secret manager.
VERIFICATION_HMAC_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# SMTP with STARTTLS (587), or set SMTP_USE_SSL=true for implicit TLS (usually 465).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=VaiProPolo <no-reply@example.com>

# Twilio Messaging: configure approved SMS and WhatsApp senders in the provider console.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
TWILIO_SMS_FROM=+10000000000
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
